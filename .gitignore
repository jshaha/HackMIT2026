# Patient health data — never commit the database
*.db
*.db-journal
*.db-wal
vitals.db

# Secrets — API keys, never commit
.env
.env.*
!.env.example

# Captured media
*.wav
voice.wav

# Third-party model repos (their own git clones + large weights) — clone separately
open-rppg/
papagei-foundation-model/

# Python caches
__pycache__/
*.pyc
.DS_Store

# Node (belt-and-suspenders; vitals-dashboard/.gitignore also covers these)
node_modules/
dist/

# Monitor runtime
logs/
.monitor.pids
vitals-dashboard/public/preview.jpg

# Live runtime outputs (regenerated by the monitor)
vitals-dashboard/public/reading.json
decision.json
voice_features.json

# Patient voice print (biometric)
patient_voice.npy
enroll.wav

# iOS app build output
vitals-ar-ios/build/
xcuserdata/
*.xcuserstate
vitals-dashboard/public/agenda_state.json
models/
vitals-dashboard/public/visit_summary.json

# Veeva runtime state (definitions in veeva/*.json stay committed)
veeva/edc_store.json
vitals-dashboard/public/edc_forms.json
vitals-dashboard/public/soa_state.json
vitals-dashboard/public/oversight_state.json
vitals-dashboard/public/monitoring_report.json
vitals-dashboard/public/transcript.json
